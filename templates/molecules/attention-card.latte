{* molecules/attention-card.latte — 注意力事项卡片
   @param  $item['type']      string  money_losing|bot_surge|zero_clicks
   @param  $item['severity']  string  crit|warn|info
   @param  $item['title']     string  标题
   @param  $item['desc']      string  描述
   @param  $item['action']    string  按钮文字
   @param  $item['actionUrl'] string  按钮链接
*}

{var $sevIcons = ['crit' => '🔴', 'warn' => '🟡', 'info' => 'ℹ️']}
{var $sevBgs  = ['crit' => 'var(--danger-soft)', 'warn' => 'var(--warning-soft)', 'info' => 'var(--surface-overlay)']}

<div class="attention-card"
     style="display:flex;align-items:center;gap:var(--space-3);background:{$sevBgs[$item['severity']]};border:1px solid var(--border-default);border-radius:var(--radius-lg,12px);padding:var(--space-3) var(--space-4);margin-bottom:var(--space-2)"
     data-health-target="attention" data-health-severity-param="{$item['severity']}">
  <span style="font-size:1.2rem;flex-shrink:0">{$sevIcons[$item['severity']]}</span>
  <div style="flex:1;min-width:0">
    <div style="font-weight:600;font-size:var(--text-sm);color:var(--content-primary);margin-bottom:2px">{$item['title']}</div>
    <div style="font-size:var(--text-xs);color:var(--content-tertiary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{$item['desc']}</div>
  </div>
  <a href="{$item['actionUrl']}"
     style="flex-shrink:0;display:inline-flex;align-items:center;padding:6px 14px;background:var(--accent);color:var(--text-inverse);border-radius:var(--radius-sm,6px);font-size:var(--text-xs);font-weight:600;text-decoration:none;white-space:nowrap">{$item['action']} →</a>
</div>

<!-- L3:OK attention-card -->
