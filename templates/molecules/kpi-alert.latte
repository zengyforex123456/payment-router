{* molecules/kpi-alert.latte — KPI 健康卡片 (带阈值红绿灯)
   @param  $id       string  卡片ID
   @param  $label    string  指标名称
   @param  $value    string  核心数值
   @param  $desc     string  辅助说明
   @param  $status   string  ok|warn|crit|idle
   @param  $trend    string  可选: up|down|flat *}
{var $statusColors = ['ok' => 'var(--content-success)', 'warn' => 'var(--warning)', 'crit' => 'var(--content-danger)', 'idle' => 'var(--content-tertiary)']}
{var $statusBgs   = ['ok' => 'var(--surface-success, #e6f9f1)', 'warn' => 'var(--warning-soft)', 'crit' => 'var(--danger-soft)', 'idle' => 'var(--surface-overlay)']}
{var $statusBorders = ['ok' => 'var(--border-success, #a3e4c1)', 'warn' => 'var(--warning)', 'crit' => 'var(--danger)', 'idle' => 'var(--border-default)']}

<div class="kpi-alert-card"
     style="background:{$statusBgs[$status]};border:1px solid {$statusBorders[$status]};border-radius:var(--radius-lg,12px);padding:var(--space-4);transition:all var(--motion-fast,0.15s)"
     data-health-target="card" data-health-status-param="{$status}">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-1)">
    <span style="font-size:var(--text-xs);color:var(--content-tertiary);text-transform:uppercase;letter-spacing:0.5px;font-weight:600">{$label}</span>
    {if isset($trend) && $trend != 'flat'}
      <span style="font-size:var(--text-xs)">
        {if $trend == 'up'}↑{elseif $trend == 'down'}↓{/if}
      </span>
    {/if}
  </div>
  <div style="font-size:var(--text-2xl);font-weight:700;color:{$statusColors[$status]};font-variant-numeric:tabular-nums;line-height:1.2">{$value}</div>
  <div style="font-size:var(--text-xs);color:var(--content-tertiary);margin-top:var(--space-1)">{$desc}</div>
</div>

<!-- L3:OK kpi-alert -->
