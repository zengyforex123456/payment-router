{* L1 原子: Icon — SVG 图标库 (24 icons, Lucide-style 24x24) *}
{* 用法: {include 'atoms/icon.latte', name:'dashboard', size:20} *}
<svg class="{if isset($class)}{$class}{/if}"
     width="{($size ?? 20)}" height="{($size ?? 20)}"
     viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true">
{var $iconPath = 'icons/' . $name . '.svg'}
{include $iconPath}
</svg>
