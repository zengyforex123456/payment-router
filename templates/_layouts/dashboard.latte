{* DashboardLayout — app shell: sidebar + optional header + content block + optional footer *}
<div class="max-w-full mx-auto px-6 w-full">
<div class="min-h-screen bg-surface-base flex">
  {* Sidebar (optional — pass via $sidebar variable) *}
  {if ($sidebar ?? null) !== null}
  <aside class="{($sidebarWidth ?? 'w-64')} min-h-screen border-r border-default bg-surface-raised flex-shrink-0 hidden lg:block">
    {=($sidebar ?? '')|noescape}
  </aside>
  {/if}

  {* Main area *}
  <div class="flex-1 flex flex-col min-w-0">
    {* Header (optional — pass $header variable) *}
    {if ($header ?? null) !== null}
    <header class="h-16 border-b border-default bg-surface-raised flex items-center px-6 flex-shrink-0">
      {=($header ?? '')|noescape}
    </header>
    {/if}

    {* Main content — uses {block content} from child template *}
    <main class="flex-1 overflow-y-auto p-6">
      {include content}
    </main>

    {* Footer (optional — pass $footer variable) *}
    {if ($footer ?? null) !== null}
    <footer class="border-t border-default bg-surface-raised px-6 py-4 text-sm text-content-secondary flex-shrink-0">
      {=($footer ?? '')|noescape}
    </footer>
    {/if}
  </div>
</div>
</div>
