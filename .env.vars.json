{
  "app_name": "payment-router",
  "description": "Payment Router — PHP 独立支付路由服务",
  "vars": {
    "DB_HOST": "dokku-mysql-payment-db",
    "DB_PORT": "3306",
    "DB_NAME": "payment_db",
    "DB_USER": "mysql",
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  },
  "sensitive": ["DB_PASSWORD", "STRIPE_SECRET_KEY", "PADDLE_API_KEY", "APP_SECRET"],
  "env_source": ".env.payment-router",
  "deployed": true,
  "notes": "Dockerfile EXPOSE 需改为 5000；DB_PASSWORD 由 Dokku MySQL link 自动注入"
}
