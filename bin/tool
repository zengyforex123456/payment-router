#!/usr/bin/env php
<?php
/**
 * bin/tool — Converge 工具网格统一入口
 *
 * 用法:
 *   php bin/tool list                    列出所有工具
 *   php bin/tool run <name> [--opt=val]  执行工具
 *   php bin/tool run <name> --dry-run    预览
 *   php bin/tool sync                    扫描+注册+淘汰
 *   php bin/tool status                  查看迁移状态
 *
 * 工具自动发现: 扫描 tools/ 目录 → 反射 #[Tool] Attribute → 注册
 * 注册表: storage/tool-registry.json (自动维护)
 */

declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use Converge\Tool\ToolDiscovery;
use Converge\Tool\ToolResult;
use Converge\Tool\ToolRunner;

// ── CLI 颜色 ──
define('C_RESET', "\033[0m");
define('C_BOLD',  "\033[1m");
define('C_GREEN', "\033[32m");
define('C_RED',   "\033[31m");
define('C_CYAN',  "\033[36m");

$command = $argv[1] ?? 'list';
$name    = $argv[2] ?? '';

// 解析参数
$params = [];
$dryRun = false;
for ($i = 3, $max = count($argv); $i < $max; $i++) {
    $arg = $argv[$i];
    if ($arg === '--dry-run') {
        $dryRun = true;
    } elseif (str_starts_with($arg, '--')) {
        $parts = explode('=', substr($arg, 2), 2);
        $params[$parts[0]] = $parts[1] ?? true;
    }
}

// 路由
match ($command) {
    'list'   => cmd_list(),
    'run'    => cmd_run($name, $params, $dryRun),
    'sync'   => cmd_sync(),
    'status' => cmd_status(),
    default  => cmd_help(),
};

// ═══════════════════════════════════════

function cmd_list(): void
{
    $r = new ToolDiscovery();
    $r->sync(); // 先同步，确保注册表最新
    $tools = $r->getRegistry()->listActive();

    echo C_BOLD . "工具列表 (" . count($tools) . " 个)\n" . C_RESET;
    echo str_repeat('─', 60) . "\n";

    foreach ($tools as $name => $meta) {
        $cat  = $meta['category'] ?? '?';
        $desc = $meta['description'] ?? '';
        $used = $meta['usage_count'] ?? 0;
        echo sprintf("  %-30s %-12s %s\n",
            C_GREEN . $name . C_RESET,
            C_CYAN . "[$cat]" . C_RESET,
            $desc
        );
    }
    echo str_repeat('─', 60) . "\n";
}

function cmd_run(string $name, array $params, bool $dryRun): void
{
    if (! $name) {
        echo C_RED . "用法: php bin/tool run <name> [--dry-run] [--opt=val ...]\n" . C_RESET;
        echo "先 php bin/tool list 查看可用工具\n";
        exit(1);
    }

    // 统一通过 ToolRunner 执行 (六可自动注入)
    $runner = new ToolRunner(dirname(__DIR__));
    $result = $runner->run($name, $params, ['dryRun' => $dryRun]);

    // 更新使用计数
    $r = new ToolDiscovery();
    $r->sync();
    $r->getRegistry()->incrementUsage($name);
    $r->getRegistry()->save();

    // 结果已由 ToolRunner 输出摘要
    if (!$result->ok) exit(1);
}

function cmd_sync(): void
{
    echo C_CYAN . "🔄 同步工具注册表...\n" . C_RESET;
    $r = new ToolDiscovery();
    $stats = $r->sync();
    echo C_GREEN . "✅ 注册: {$stats['registered']}  淘汰: {$stats['deactivated']}\n" . C_RESET;
    echo "   注册表: " . $r->getRegistry()->getFile() . "\n";
}

function cmd_status(): void
{
    $statusFile = dirname(__DIR__) . '/storage/migration-status.json';
    if (file_exists($statusFile)) {
        $status = json_decode(file_get_contents($statusFile), true);
        $counts = array_count_values(array_column($status, 'status'));
        echo C_BOLD . "模板迁移状态\n" . C_RESET;
        foreach (['converted', 'hybrid', 'pending'] as $s) {
            $n = $counts[$s] ?? 0;
            $icon = $s === 'converted' ? '✅' : ($s === 'hybrid' ? '🔧' : '⬜');
            echo "  $icon $s: $n\n";
        }
    } else {
        echo C_CYAN . "暂无迁移状态文件\n" . C_RESET;
        echo "创建: storage/migration-status.json\n";
    }
}

function cmd_help(): void
{
    echo C_BOLD . "Converge 工具网格\n" . C_RESET;
    echo "\n用法:\n";
    echo "  php bin/tool list              列出所有工具\n";
    echo "  php bin/tool run <name>        执行工具\n";
    echo "  php bin/tool run <name> --dry-run  预览\n";
    echo "  php bin/tool sync              扫描+注册+淘汰\n";
    echo "  php bin/tool status            迁移状态\n";
    echo "\n";
}
