# ─── Converge 项目环境变量模板 (v2.0) ───
# 复制此文件为 .env 并填写真实值
# 统一命名规范: 所有 PHP 项目使用 DB_HOST / DB_USER / DB_PASSWORD / DB_NAME
#
# ❌ 废弃: DB_USERNAME, DB_DATABASE, DB_PASS
# ✅ 标准: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD

# ─── 数据库 (MySQL 8.0 / MariaDB) ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=converge_db
DB_USER=mysql
DB_PASSWORD=

# ─── 数据库连接 URL (Docker 内网禁用 SSL) ───
# Dokku 自动注入 DATABASE_URL，末尾强制 ?ssl-mode=DISABLED
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?ssl-mode=DISABLED

# ─── 应用 ───
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_SECRET=

# ─── Redis ───
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── SMTP (告警通知) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ENCRYPTION=tls

# ─── 告警接收 ───
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ─── 广告平台 ───
FACEBOOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# ─── License ───
LICENSE_KEY=
